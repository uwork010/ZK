# Contact form (src/app/api/contact/route.ts)
# Sign up at https://resend.com (free tier: 100 emails/day, 3000/month)
RESEND_API_KEY=

# Where the form submissions are delivered
CONTACT_TO_EMAIL=

# Optional — direct WhatsApp contact link, e.g. https://wa.me/<country-code-and-number>
NEXT_PUBLIC_WHATSAPP_URL=

# Optional — verified sender. Defaults to Resend's onboarding sender.
# Once you verify a domain on Resend, set this to your organization's verified sender.
CONTACT_FROM_EMAIL=

# Verified public origin used for canonical metadata and sitemap URLs
NEXT_PUBLIC_SITE_URL=
